{
  "serviceName": "karrio-worker",
  "desiredCount": 1,
  "launchType": "FARGATE",
  "platformVersion": "LATEST",
  "schedulingStrategy": "REPLICA",
  "deploymentController": {
    "type": "ECS"
  },
  "deploymentConfiguration": {
    "maximumPercent": 200,
    "minimumHealthyPercent": 100,
    "deploymentCircuitBreaker": {
      "enable": true,
      "rollback": true
    }
  },
  "healthCheckGracePeriodSeconds": 60,
  "networkConfiguration": {
    "awsvpcConfiguration": {
      "subnets": [
        "{{ tfstate `output.private_subnet_ids[0]` }}",
        "{{ tfstate `output.private_subnet_ids[1]` }}",
        "{{ tfstate `output.private_subnet_ids[2]` }}"
      ],
      "securityGroups": [
        "{{ tfstate `output.karrio_api_security_group_ids[0]` }}"
      ],
      "assignPublicIp": "DISABLED"
    }
  },
  "enableECSManagedTags": true,
  "enableExecuteCommand": true,
  "propagateTags": "SERVICE",
  "tags": [
    {
      "key": "Name",
      "value": "karrio-worker"
    },
    {
      "key": "ManagedBy",
      "value": "ecspresso"
    }
  ]
}